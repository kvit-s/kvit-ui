+// FaceLoader loads the face stored at a location on disk. See
+// [FontMap.SetFaceLoader].
+type FaceLoader func(location Location) (*font.Face, error)
+
+// SetFaceLoader replaces how the font map loads a system font once it has
+// chosen one. By default the whole font file is read and parsed. A caller
+// that only shapes text, and draws glyphs by other means, can load a lighter
+// face instead: for example one parsed from a copy of the font without its
+// outline, bitmap and colour tables, which a font parser otherwise holds in
+// memory for the life of the face. Pass nil to restore the default. Faces
+// already loaded are kept.
+func (fm *FontMap) SetFaceLoader(loader FaceLoader) { fm.faceLoader = loader }
+
 func (fm *FontMap) loadFont(fp Footprint) (*font.Face, error) {
 	if face, hasCached := fm.faceCache[fp.Location]; hasCached {
